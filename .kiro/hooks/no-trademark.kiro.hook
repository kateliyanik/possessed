{
  "enabled": true,
  "name": "Trademark check",
  "description": "Keep the trademarked name out of the spirit board app and all user-facing text.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["apps/**/*", "kit/client/**/*", "kit/demo/**/*", "README.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check the edited file for the word 'Ouija' in any letter case, including in identifiers, file names, alt text and comments. The product rule is to say 'spirit board' instead. Replace any occurrence and report it. Also flag any third-party logo, font or audio file that is not original or clearly licensed."
  }
}
